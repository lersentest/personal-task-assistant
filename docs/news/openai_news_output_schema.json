{
  "name": "news_article_processing_result",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title_ru",
      "summary_ru",
      "key_facts",
      "category",
      "tags",
      "summary_basis",
      "relevance_score",
      "quality_score",
      "is_advertisement",
      "is_clickbait",
      "content_sufficient",
      "warning"
    ],
    "properties": {
      "title_ru": {"type": "string", "minLength": 5, "maxLength": 180},
      "summary_ru": {"type": "string", "minLength": 300, "maxLength": 2500},
      "key_facts": {
        "type": "array",
        "minItems": 2,
        "maxItems": 5,
        "items": {"type": "string", "minLength": 5, "maxLength": 240}
      },
      "category": {
        "type": "string",
        "enum": [
          "STONE_INDUSTRY",
          "STONE_MACHINERY",
          "CONSTRUCTION",
          "SWISS_CONSTRUCTION",
          "ARCHITECTURE",
          "INTERIOR_DESIGN",
          "MATERIALS",
          "BUSINESS_MARKET",
          "EVENTS"
        ]
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {"type": "string", "minLength": 2, "maxLength": 40}
      },
      "summary_basis": {
        "type": "string",
        "enum": ["FULL_TEXT", "EXCERPT", "SOCIAL_POST"]
      },
      "relevance_score": {"type": "integer", "minimum": 0, "maximum": 100},
      "quality_score": {"type": "integer", "minimum": 0, "maximum": 100},
      "is_advertisement": {"type": "boolean"},
      "is_clickbait": {"type": "boolean"},
      "content_sufficient": {"type": "boolean"},
      "warning": {"type": ["string", "null"], "maxLength": 300}
    }
  }
}
